# CPU-safe local development. scripts/Setup-Windows.ps1 generates private keys
# and resolves storage paths; never copy another PC's .env or signing secret.
SMART_WARDROBE_ENVIRONMENT=development
SMART_WARDROBE_TOKEN_SECRET=GENERATE_LOCALLY
# Existing configured installations can opt into Grammar 1.4.1 with the value
# local_semantic_nlp_appearance_v1. Preserve the other profile dependencies.
SMART_WARDROBE_DEVELOPMENT_SEMANTIC_PROFILE=local_semantic_nlp_v1
SMART_WARDROBE_ALLOW_DEV_IDENTITY=false
SMART_WARDROBE_DATA_DIR=../storage/portable-development
SMART_WARDROBE_DATABASE=../storage/portable-development/smart_wardrobe.db
SMART_WARDROBE_MAIN_FIXTURE_CONFIG=../storage/portable-development/phase2nd/runtime.private.json
SMART_WARDROBE_AI_MODE=development
SMART_WARDROBE_VTOFF_ENABLED=false
SMART_WARDROBE_VTON_ENABLED=false
SMART_WARDROBE_EMBEDDING_ENABLED=false
SMART_WARDROBE_FASHIONPEDIA_ATTRIBUTES_ENABLED=false
# Production garment inference runs in a child process. A native torch/model
# crash then fails only that job rather than the API service.
SMART_WARDROBE_PROCESSING_ISOLATION=auto
SMART_WARDROBE_HOMEPAGE_ENABLED=true
SMART_WARDROBE_ASSISTANT_ENABLED=true
SMART_WARDROBE_ASSISTANT_SUITABILITY_ENABLED=true
SMART_WARDROBE_ASSISTANT_CONTEXT_PROFILE=general_context_v1
SMART_WARDROBE_ASSISTANT_CONTEXT_BUNDLE=context_18_v1
SMART_WARDROBE_ASSISTANT_CONTEXT_RANKING_PROFILE=context_relevance_decision_v1
SMART_WARDROBE_ASSISTANT_SCORING_PROFILE=experimental_compatibility_decision_v1
SMART_WARDROBE_ASSISTANT_EXECUTION_ENGINE=compact_exhaustive
SMART_WARDROBE_DESCRIPTION_PROFILE=description_evidence_v1
SMART_WARDROBE_ASSISTANT_ATTRIBUTE_PROFILE=attribute_requests_v1
SMART_WARDROBE_ASSISTANT_LANGUAGE_PROFILE=conversational_language_v1
SMART_WARDROBE_WEARER_CATEGORY_PROFILE=gender_category_v1
SMART_WARDROBE_VERIFIED_SUBTYPE_PROFILE=disabled
SMART_WARDROBE_ASSISTANT_LOCAL_PREFERENCE_PROFILE=request_local_bounded_preference_v1
SMART_WARDROBE_ASSISTANT_NORMALIZATION_PROFILE=disabled
SMART_WARDROBE_ASSISTANT_COMPOSITION_PROFILE=bounded_compositional_input_v1
SMART_WARDROBE_DEVELOPMENT_FIXTURE_PROFILE=phase2nd_main_fixture_v1
SMART_WARDROBE_DEVELOPMENT_MIXED_PROFILE=phase2nd_mixed_v1
SMART_WARDROBE_DEVELOPMENT_MIXED_CONTEXT_PROFILE=phase2o_mixed_context_v1
SMART_WARDROBE_DEVELOPMENT_CONTEXT_LANGUAGE_PROFILE=phase2p_semantic_context_v1
SMART_WARDROBE_DEVELOPMENT_INTERVIEW_DEFAULT_PROFILE=smart_casual_interview_default_v1
SMART_WARDROBE_DEVELOPMENT_FASHION_PROFILE=fashion_compatibility_v2
SMART_WARDROBE_DEVELOPMENT_PERSONALIZATION_PROFILE=explicit_preferences_diversity_v1
